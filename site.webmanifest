{
  "name": "MacEx",
  "short_name": "MacEx",
  "description": "A file library app for Mac: find, preview and clean up your files.",
  "start_url": "/",
  "display": "browser",
  "background_color": "#f7f9fc",
  "theme_color": "#f7f9fc",
  "icons": [
    { "src": "/assets/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/assets/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/assets/mascot.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
